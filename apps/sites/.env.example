# Referencia de las variables que usa apps/sites (sitio público de las
# inmobiliarias). No copiar a un .env con valores reales: los secretos salen
# de Doppler. Acá van vacíos o con el valor de desarrollo.

# URL base de la API (adminprop-backend), con el prefijo de versión. Si falta,
# se usa NEXT_PUBLIC_API_URL.
API_URL=http://localhost:3000/api/v1

# Opcional. Milisegundos que se espera a la API antes de darla por caída
# (default 8000). Solo para probar el corte.
# API_TIMEOUT_MS=8000

# Secreto compartido con la API (X-Sites-Secret). Va en las lecturas cacheadas
# y en el formulario de contacto (junto con X-Client-IP). Nunca NEXT_PUBLIC_.
# Si falta, se usa SITES_REVALIDATE_SECRET.
SITES_SERVER_SECRET=
# Secreto del aviso de publicación (POST /api/revalidate). Sin valor el
# endpoint está apagado.
SITES_REVALIDATE_SECRET=

# Dominio base de los subdominios (<slug>.<SITES_BASE_DOMAIN>).
SITES_BASE_DOMAIN=localhost
# https por defecto; http solo en desarrollo.
SITES_PROTOCOL=http

# true solo si un proxy propio fija X-Forwarded-Host (si no, lo escribe
# cualquiera).
SITES_TRUST_FORWARDED_HOST=false
# true para habilitar el acceso por slug (/_s/<slug>) en producción. En
# desarrollo ya está abierto.
SITES_ALLOW_SLUG_PATH=false

# Orígenes del backoffice que pueden embeber la vista previa (espacio o coma).
# Sin valor en desarrollo: http://localhost:3001 http://127.0.0.1:3001.
SITES_PREVIEW_ANCESTORS=
# Orígenes extra de imágenes para la CSP (espacio o coma). Sin valor en
# desarrollo: http://localhost:3000 (storage local).
SITES_IMAGE_SOURCES=

# IP del visitante (límite por IP del proxy y del formulario de contacto).
# Header que garantiza la plataforma (x-real-ip, cf-connecting-ip…); si no,
# se cuenta X-Forwarded-For desde la derecha según SITES_TRUSTED_PROXY_HOPS.
# En producción (NODE_ENV=production) SIN este header no se manda X-Client-IP:
# el último X-Forwarded-For lo puede elegir el cliente si nadie adelante lo
# agrega. Configurarlo siempre que haya un proxy/CDN. En desarrollo se usa XFF.
SITES_CLIENT_IP_HEADER=
SITES_TRUSTED_PROXY_HOPS=1
