# Referencia de las variables que usa la app. No copiar a un .env: los
# valores salen de Doppler (proyecto admin-prop, config dev_portal).

# URL base de la API (adminprop-backend), con el prefijo de versión.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Slug de la inmobiliaria dueña de este portal (Fase 4). Sin valor, el login
# del portal avisa que no hay inmobiliaria configurada. En la Fase 22 pasa a
# resolverse por dominio. En desarrollo: demo (la del seed).
PORTAL_TENANT_SLUG=demo
