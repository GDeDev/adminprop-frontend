# Referencia de las variables que usa la app. No copiar a un .env: los
# valores salen de Doppler (proyecto admin-prop, config dev_backoffice).

# URL base de la API (adminprop-backend), con el prefijo de versión.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Opcional. Orígenes públicos de la app (separados por coma) cuando corre detrás
# de un proxy reverso que no manda X-Forwarded-Host/-Proto. Ver ANTES_DE_PROBAR.md.
# APP_ORIGINS=https://app.ejemplo.com
# URL de apps/sites (el sitio de las inmobiliarias). La vista previa de
# "Mi sitio web" arma el iframe con ella. Sin definir: http://localhost:3003.
NEXT_PUBLIC_SITES_URL=http://localhost:3003

# Destino del CNAME que se muestra al configurar un dominio propio en
# "Mi sitio web" (lo define cada despliegue). Sin valor no se muestra.
NEXT_PUBLIC_SITES_DNS_TARGET=

# Opcional. Secreto compartido con la API (X-Sites-Secret) para que crea la IP
# del usuario que el BFF le pasa en X-Client-IP al refrescar la sesión. Sin él,
# todos los usuarios comparten el límite por IP de la API (el de este servidor).
# Solo servidor: nunca NEXT_PUBLIC_.
API_SERVER_SECRET=
# IP del usuario para ese header: el que garantiza la plataforma (x-real-ip…)
# o X-Forwarded-For contado desde la derecha según TRUSTED_PROXY_HOPS.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1

# SITES_IMAGE_SOURCES y SITES_PREVIEW_ANCESTORS son de apps/sites (ver su
# .env.example): el backoffice no las lee.
