{
  "name": "adminprop",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "test": "turbo run test",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "api:types": "npm run api:types -w @adminprop/shared-types"
  },
  "devDependencies": {
    "@adminprop/eslint-config": "*",
    "@adminprop/typescript-config": "*",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.11.2",
    "typescript": "^5"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
