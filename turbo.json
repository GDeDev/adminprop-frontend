{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": false,
      "env": [
        "NEXT_PUBLIC_*",
        "PORTAL_TENANT_SLUG",
        "API_URL",
        "SITES_PREVIEW_ANCESTORS",
        "SITES_ALLOW_SLUG_PATH",
        "SITES_TRUST_FORWARDED_HOST",
        "SITES_IMAGE_SOURCES",
        "SITES_REVALIDATE_SECRET",
        "SITES_BASE_DOMAIN",
        "SITES_PROTOCOL",
        "SITES_CLIENT_IP_HEADER",
        "SITES_TRUSTED_PROXY_HOPS",
        "APP_ORIGINS"
      ]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "format": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  },
  "globalEnv": ["NODE_ENV"]
}
